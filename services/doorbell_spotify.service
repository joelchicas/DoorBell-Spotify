[Unit]
Description=Doorbell Spotify Player
After=network.target sound.target
Wants=sound.target

[Service]
ExecStart=/usr/bin/python3 %h/doorbell_spotify.py
WorkingDirectory=%h
User=%u
Restart=always
RestartSec=5

EnvironmentFile=%h/.env
Environment="SDL_AUDIODRIVER=alsa"
Environment="AUDIODEV=plughw:2,0"

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
